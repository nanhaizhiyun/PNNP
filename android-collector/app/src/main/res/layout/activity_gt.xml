<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="GT 采集（干净图像，供去噪网络学习图像内容）\n输出: DarkFrameCollector/&lt;时间戳&gt;/gt/&lt;模式&gt;/&lt;场景&gt;/*.dng\n低光条件由训练时 PNNP 代理合成，GT 无需暗环境/长曝光"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="采集模式" />
    <Spinner
        android:id="@+id/spMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="场景名（每次开始采集 = 一个场景一个目录）" />
    <EditText
        android:id="@+id/etScene"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="如 indoor_plant_01"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ISO" />
    <EditText
        android:id="@+id/etIso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="50"
        android:inputType="number"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="曝光时间 ms" />
    <EditText
        android:id="@+id/etExposure"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="10"
        android:inputType="numberDecimal"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="帧数（多帧平均 = burst 帧数；直拍 = 连拍张数）" />
    <EditText
        android:id="@+id/etFrames"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="3"
        android:inputType="number"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnPreset"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="模式预设" />
        <Button
            android:id="@+id/btnTest"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="抓拍测试" />
        <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="开始采集" />
        <Button
            android:id="@+id/btnStop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:text="停止" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="就绪"
        android:textSize="13sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp">
        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:typeface="monospace" />
    </ScrollView>
</LinearLayout>
